# Fichero generado por Terraform (inventario.tf): no lo edites a mano
[servidores_lb]
lb ansible_host=${ip_lb} ansible_user=debian

[servidores_web]
%{ for nombre, w in webs ~}
${nombre} ansible_host=${w.ip_balanceo} ansible_user=debian ip_datos=${w.ip_datos}
%{ endfor ~}

# Los backends no tienen ruta desde el host (mi portátil): se accede saltando por lb (balanceador)
[servidores_web:vars]
ansible_ssh_common_args='-o ProxyCommand="ssh -W %h:%p -q -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null debian@${ip_lb}"'

[servidores_bd]
bd ansible_host=${ip_bd} ansible_user=ubuntu
