network:
  version: 2
  ethernets:
    ens3:                                # red de balanceo (estática, sin NAT)
      dhcp4: false
      addresses: ["${ip_balanceo}/24"]
      routes:
        - to: 0.0.0.0/0
          via: ${ip_gateway}             # lb hace de router NAT
      nameservers:
        addresses: [192.168.120.1]
