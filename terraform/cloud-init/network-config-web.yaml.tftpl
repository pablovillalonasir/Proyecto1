network:
  version: 2
  ethernets:
    ens3:
      dhcp4: false
      addresses: ["${ip_balanceo}/24"]                    # red de balanceo estática
      routes:
	- to: 0.0.0.0/0
	  via: ${ip_gateway}				  # lb hace de router NAT
      nameservers:
	addresses: [1.1.1.1, 8.8.8.8]
    ens4:
      dhcp4: false
      addresses: ["${ip_datos}/24"]  			  # red de datos (estática)
